<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notif_surface_dark"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Top Row: Leading Coral Red Badge + Primary 26sp Bold Countdown + Inline Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Leading Coral Red Badge on Right in RTL -->
        <FrameLayout
            android:id="@+id/notif_leading_badge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_notif_badge_coral">

            <ImageView
                android:id="@+id/notif_badge_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_notification_timer"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Primary Time Display & Task Title -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/notif_remaining_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="25:00"
                    android:textColor="#F2F2F5"
                    android:textDirection="ltr"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/notif_phase_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="جلسة تركيز"
                    android:textColor="#E05246"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/notif_task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="جلسة تركيز"
                android:textColor="#F2F2F5"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_secondary_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="جلسة تركيز • مضى: 00:00 • 🍅 0"
                android:textColor="#A0A0AB"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Opposite-End Quick Action Control Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notif_btn_pause_resume"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_notif_btn_coral"
                android:gravity="center"
                android:minWidth="80dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="إيقاف مؤقت"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_btn_stop"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_notif_btn_secondary"
                android:gravity="center"
                android:minWidth="60dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="إنهاء"
                android:textColor="#F2F2F5"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
